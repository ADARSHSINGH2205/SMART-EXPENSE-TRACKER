# Port exposed by Docker Compose. Open http://localhost:8080 after startup.
PAYARC_PORT=8080

# Keep the UI and API on one origin unless you have configured CORS separately.
# This value is baked into the React build, so rebuild after changing it.
VITE_API_URL=/api

# The default database is stored in the persistent Docker volume mounted at /data.
PAYARC_DATABASE_URL=sqlite:////data/payarc.db

# Optional: enables PayArc Copilot and receipt OCR through Gemini.
# Put your real key only in the ignored .env file; never commit it.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
